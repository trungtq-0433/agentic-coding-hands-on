# CLI Supabase đọc file .env (KHÔNG phải .env.local) để thay thế env() trong
# supabase/config.toml. Đã kiểm chứng bằng thực nghiệm 2026-08-05: đặt biến vào
# .env rồi `supabase stop && supabase start` thì giá trị được thay thế thật.
#
# Next.js thì đọc .env.local. Hai file, hai người tiêu thụ khác nhau — đừng gộp.
# Chép file này thành .env rồi điền giá trị thật. .env đã gitignore.

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
