# Chép file này thành .env.local rồi điền giá trị thật.
# Giá trị Supabase lấy NGUYÊN VĂN từ output của `npx supabase start` —
# đừng copy từ tài liệu, tên key đổi theo version CLI.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Mốc thời gian countdown — ISO-8601 kèm offset +07:00 (Asia/Ho_Chi_Minh).
# NEXT_PUBLIC_LAUNCH_GATE_AT : cổng chặn toàn site, trước mốc này mọi URL về /prelaunch
# NEXT_PUBLIC_EVENT_START_AT : countdown trên Homepage
#
# đổi giá trị này BẮT BUỘC chạy lại "next build" — restart không đủ.
# Biến NEXT_PUBLIC_* bị inline vào bundle lúc build. Xem docs/runbook-su-kien.md.
NEXT_PUBLIC_LAUNCH_GATE_AT=2025-11-20T09:00:00+07:00
NEXT_PUBLIC_EVENT_START_AT=2025-12-20T18:00:00+07:00
