# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example thì phải commit (dòng .env* ở trên nuốt mất nó)
!/.env.local.example
!/.env.example

# supabase local
/supabase/.temp
/supabase/.branches

# sunlint
/.takumi
/.sunlint-eslint.config.js

# File credential tải từ Google Cloud Console — không bao giờ vào git
client_secret*.json

# playwright MCP scratch output
/.playwright-mcp
